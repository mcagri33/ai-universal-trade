# Universal AI Trader - Environment Configuration
# Only essential credentials and system settings

# Exchange API Credentials
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Telegram Bot Configuration
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_ADMIN_ID=your_telegram_user_id_here

# Database Configuration
DB_HOST=localhost
DB_USER=trader
DB_PASS=strongpassword
DB_NAME=universal_ai_trader

# System Configuration
NODE_ENV=production
LOG_LEVEL=info

# Note: All trading settings (exchange, symbol, amounts, etc.) 
# are managed dynamically via Telegram commands and MySQL database
